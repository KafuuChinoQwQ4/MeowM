import { Button, CheckBox, ComboBox, LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { LedgerState } from "state.slint";
import { MeowTheme } from "theme.slint";

export component SettingsPage inherits ScrollView {
    in-out property <int> section: 0;
    VerticalBox { spacing: 12px;
        Text { text: section == 0 ? "设置" : section == 1 ? "账户与分类" : section == 2 ? "来源与通知" : section == 3 ? "备份与安全" : "数据管理"; font-size: 28px; font-weight: 700; color: MeowTheme.ink; }
        if section != 0: Button { text: "‹ 返回设置"; clicked => { section = 0; } }
        if section == 0: VerticalBox { spacing: 9px;
            Text { text: "按用途管理你的账本"; color: MeowTheme.muted; }
            Rectangle { background: MeowTheme.surface-blue; border-radius: 8px; min-height: 68px;
                Text { text: "账户与分类  ›"; x: 16px; y: 15px; color: MeowTheme.primary-dark; font-size: 17px; font-weight: 700; }
                Text { text: "账户、分类和自动分类规则"; x: 16px; y: 41px; color: MeowTheme.muted; font-size: 12px; }
                TouchArea { clicked => { section = 1; } }
            }
            Rectangle { background: MeowTheme.surface-pink; border-radius: 8px; min-height: 68px;
                Text { text: "来源与通知  ›"; x: 16px; y: 15px; color: MeowTheme.primary-dark; font-size: 17px; font-weight: 700; }
                Text { text: "文件导入、通知采集和 API 意向"; x: 16px; y: 41px; color: MeowTheme.muted; font-size: 12px; }
                TouchArea { clicked => { section = 2; } }
            }
            Rectangle { background: MeowTheme.surface-blue; border-radius: 8px; min-height: 68px;
                Text { text: "备份与安全  ›"; x: 16px; y: 15px; color: MeowTheme.primary-dark; font-size: 17px; font-weight: 700; }
                Text { text: "加密备份与恢复"; x: 16px; y: 41px; color: MeowTheme.muted; font-size: 12px; }
                TouchArea { clicked => { section = 3; } }
            }
            Rectangle { background: MeowTheme.surface; border-radius: 8px; min-height: 68px;
                Text { text: "数据管理  ›"; x: 16px; y: 15px; color: MeowTheme.ink; font-size: 17px; font-weight: 700; }
                Text { text: "删除导入批次或全部本地数据"; x: 16px; y: 41px; color: MeowTheme.muted; font-size: 12px; }
                TouchArea { clicked => { section = 4; } }
            }
        }
        if section == 1: VerticalBox { spacing: 10px;
            Text { text: "默认账户"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            ComboBox { model: LedgerState.account-names; current-index <=> LedgerState.default-account; }
            Button { text: "保存默认账户"; clicked => { LedgerState.save-settings(); } }
            Text { text: "创建账户"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            LineEdit { placeholder-text: "账户名称"; text <=> LedgerState.account-name; }
            ComboBox { model: ["资产 / 钱包 / 银行卡", "负债 / 信用卡"]; current-index <=> LedgerState.account-kind; }
            ComboBox { model: ["CNY", "USD", "EUR", "JPY", "HKD"]; current-index <=> LedgerState.account-currency; }
            LineEdit { placeholder-text: "期初余额"; text <=> LedgerState.account-opening; }
            LineEdit { placeholder-text: "余额基准日期 YYYY-MM-DD"; text <=> LedgerState.account-date; }
            Button { text: "创建账户"; clicked => { LedgerState.create-account(); } }
            Text { text: "分类管理"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            ComboBox { model: LedgerState.category-names; current-index <=> LedgerState.category-selection; }
            Button { text: "载入所选分类"; clicked => { LedgerState.select-category(LedgerState.category-selection); } }
            LineEdit { placeholder-text: "分类名称"; text <=> LedgerState.category-name; }
            CheckBox { text: "允许新交易使用"; checked <=> LedgerState.category-enabled; }
            HorizontalBox { spacing: 8px;
                Button { text: "新增分类"; clicked => { LedgerState.save-category(true); } }
                Button { text: "更新分类"; clicked => { LedgerState.save-category(false); } }
            }
            Text { text: "自动分类规则"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            Text { text: "优先级数字越小越先匹配，仅建议后续交易。"; wrap: word-wrap; color: MeowTheme.muted; }
            ComboBox { model: LedgerState.rule-names; current-index <=> LedgerState.rule-selection; }
            Button { text: "载入规则"; clicked => { LedgerState.select-rule(LedgerState.rule-selection); } }
            LineEdit { placeholder-text: "商户包含"; text <=> LedgerState.rule-merchant; }
            LineEdit { placeholder-text: "备注关键词（两项均填时需同时匹配）"; text <=> LedgerState.rule-keyword; }
            LineEdit { placeholder-text: "优先级"; text <=> LedgerState.rule-priority; }
            ComboBox { model: LedgerState.category-names; current-index <=> LedgerState.rule-category; }
            CheckBox { text: "启用规则"; checked <=> LedgerState.rule-enabled; }
            HorizontalBox { spacing: 8px;
                Button { text: "新增规则"; clicked => { LedgerState.save-rule(true); } }
                Button { text: "更新规则"; clicked => { LedgerState.save-rule(false); } }
            }
        }
        if section == 2: VerticalBox { spacing: 10px;
            Text { text: "支付通知采集"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            Text { text: "逐个启用来源并授权通知访问。通知正文仅在本机临时解析。"; wrap: word-wrap; color: MeowTheme.muted; }
            Button { text: "通知权限、来源与应用锁"; clicked => { LedgerState.notification-settings(); } }
            Text { text: "账单导入来源"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            CheckBox { text: "启用微信账单导入"; checked <=> LedgerState.import-wechat; }
            CheckBox { text: "启用支付宝账单导入"; checked <=> LedgerState.import-alipay; }
            Text { text: "银行 CSV 尚未提供通用解析器。"; color: MeowTheme.muted; }
            Button { text: "导入账单文件"; clicked => { LedgerState.navigate(6); } }
            Text { text: "可选 API 来源"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            Text { text: "微信、支付宝和银行 API 均未接入真实服务。以下开关仅保存本机使用意向，不代表已授权，也不会在线同步。"; wrap: word-wrap; color: MeowTheme.muted; }
            CheckBox { text: "允许后续 API 接入"; checked <=> LedgerState.api-enabled; }
            CheckBox { text: "微信 API 意向"; checked <=> LedgerState.api-wechat; }
            CheckBox { text: "支付宝 API 意向"; checked <=> LedgerState.api-alipay; }
            CheckBox { text: "银行 API 意向"; checked <=> LedgerState.api-bank; }
            Text { text: "未来接入仍需单独授权。获取的数据先预览、去重和确认，凭据只保存在本机安全存储。"; wrap: word-wrap; color: MeowTheme.muted; }
            Button { text: "保存来源设置"; clicked => { LedgerState.save-settings(); } }
        }
        if section == 3: VerticalBox { spacing: 10px;
            Text { text: "加密备份"; font-size: 17px; font-weight: 700; color: MeowTheme.primary-dark; }
            CheckBox { text: "启用加密备份"; checked <=> LedgerState.backup-enabled; }
            Button { text: "保存备份设置"; clicked => { LedgerState.save-settings(); } }
            Text { text: "备份密码至少 8 个字符，丢失后无法找回。"; wrap: word-wrap; color: MeowTheme.muted; }
            LineEdit { input-type: password; placeholder-text: "备份密码"; text <=> LedgerState.backup-password; }
            if !LedgerState.android-platform: LineEdit { placeholder-text: "备份文件路径"; text <=> LedgerState.backup-path; }
            Text { text: "恢复会覆盖全部本机账本；通知和 API 选择保持当前设置。"; wrap: word-wrap; color: MeowTheme.muted; }
            Button { text: "选择要恢复的备份文件"; clicked => { LedgerState.choose-backup(); } }
            CheckBox { text: "我确认导出或覆盖恢复"; checked <=> LedgerState.backup-confirmed; }
            Button { text: "导出加密备份"; clicked => { LedgerState.export-backup(); } }
            Button { text: "恢复并覆盖本机账本"; clicked => { LedgerState.restore-backup(); } }
        }
        if section == 4: VerticalBox { spacing: 10px;
            Text { text: "删除数据后无法撤销"; font-size: 17px; font-weight: 700; color: MeowTheme.expense; }
            Text { text: "批次删除仅移除该批证据；其他来源仍关联的交易保留。原支出被退款引用时须先删除退款。"; wrap: word-wrap; color: MeowTheme.muted; }
            ComboBox { model: LedgerState.batch-names; current-index <=> LedgerState.batch-selection; selected(value) => { LedgerState.select-delete-batch(self.current-index); } }
            CheckBox { text: "我确认删除所选导入批次"; checked <=> LedgerState.delete-batch-confirmed; toggled => { LedgerState.confirm-deletion(1, self.checked); } }
            Button { text: "删除所选导入批次"; clicked => { LedgerState.delete-data(1); } }
            Text { text: "全部删除还会关闭来源，清理本机凭据和缓存；已导出的备份需自行删除。"; wrap: word-wrap; color: MeowTheme.muted; }
            CheckBox { text: "我确认删除全部本地数据"; checked <=> LedgerState.delete-all-confirmed; toggled => { LedgerState.confirm-deletion(2, self.checked); } }
            Button { text: "删除全部本地数据"; clicked => { LedgerState.delete-data(2); } }
        }
    }
}
