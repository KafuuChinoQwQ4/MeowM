import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { LedgerState } from "state.slint";
import { MeowTheme } from "theme.slint";

export component PendingPage inherits ScrollView {
    VerticalBox { spacing: 12px;
        Text { text: "待确认"; font-size: 28px; font-weight: 700; color: MeowTheme.ink; }
        Text { text: "核对后再入账"; color: MeowTheme.muted; }
        if LedgerState.pending.length == 0: Rectangle { background: MeowTheme.surface-blue; border-radius: 8px; min-height: 116px;
            VerticalBox { alignment: center; spacing: 5px;
                Text { text: "✓"; font-size: 26px; color: MeowTheme.income; horizontal-alignment: center; }
                Text { text: "暂无待确认记录"; color: MeowTheme.ink; horizontal-alignment: center; font-weight: 600; }
            }
        }
        for row[index] in LedgerState.pending: Rectangle { background: MeowTheme.surface; border-radius: 8px; min-height: 126px;
            VerticalBox { padding: 14px; spacing: 8px;
                HorizontalBox { spacing: 8px;
                    Text { text: row.title; color: MeowTheme.ink; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
                    Text { text: row.amount; color: MeowTheme.expense; font-weight: 700; horizontal-alignment: right; }
                }
                Text { text: row.subtitle; color: MeowTheme.muted; overflow: elide; }
                Text { text: "未计入余额和报表"; color: MeowTheme.warning; font-size: 12px; }
                HorizontalBox { spacing: 8px;
                    Button { text: "编辑并确认"; clicked => { LedgerState.edit(index, true); } }
                    Button { text: "忽略"; clicked => { LedgerState.ignore(index); } }
                }
            }
        }
    }
}
