import { VerticalBox, ScrollView } from "std-widgets.slint";
import { LedgerState } from "state.slint";
import { MeowTheme } from "theme.slint";

export component ReportsPage inherits ScrollView {
    VerticalBox { spacing: 12px;
        Text { text: "报表"; font-size: 28px; font-weight: 700; color: MeowTheme.ink; }
        Text { text: "人民币收支分析"; color: MeowTheme.muted; }
        Rectangle { background: MeowTheme.surface-blue; border-radius: 8px; min-height: 66px;
            Text { text: "仅统计已确认交易。退款抵减净支出，转账不计入收支。"; x: 14px; y: 13px; width: parent.width - 28px; wrap: word-wrap; color: MeowTheme.primary-dark; }
        }
        if LedgerState.report-lines.length == 0: Text { text: "暂无报表数据"; color: MeowTheme.muted; }
        for line in LedgerState.report-lines: Rectangle { background: MeowTheme.surface; border-radius: 8px; min-height: 52px;
            Text { x: 14px; y: 14px; width: parent.width - 28px; text: line; wrap: word-wrap; color: MeowTheme.ink; }
        }
    }
}
