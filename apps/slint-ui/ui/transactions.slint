import { CheckBox, Button, VerticalBox, HorizontalBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { LedgerState } from "state.slint";
import { MeowTheme } from "theme.slint";

export component TransactionsPage inherits ScrollView {
    VerticalBox { spacing: 12px;
        Text { text: "交易"; font-size: 28px; font-weight: 700; color: MeowTheme.ink; }
        Text { text: "记录每一笔，也看见生活的节奏"; color: MeowTheme.muted; }
        Rectangle { background: MeowTheme.surface; border-radius: 8px; min-height: 146px;
            VerticalBox { padding: 12px; spacing: 8px;
                Text { text: "筛选记录"; font-weight: 700; color: MeowTheme.ink; }
                HorizontalBox { LineEdit { placeholder-text: "开始日期"; text <=> LedgerState.from-date; } LineEdit { placeholder-text: "结束日期"; text <=> LedgerState.until-date; } }
                HorizontalBox { ComboBox { model: ["全部来源", "手动", "微信", "支付宝", "银行", "通知"]; current-index <=> LedgerState.filter-source; } ComboBox { model: ["全部状态", "待确认", "已确认", "已忽略"]; current-index <=> LedgerState.filter-status; } }
                HorizontalBox { ComboBox { model: LedgerState.account-names; current-index <=> LedgerState.filter-account; } ComboBox { model: LedgerState.category-names; current-index <=> LedgerState.filter-category; } }
                Rectangle { background: MeowTheme.primary; border-radius: 8px; min-height: 38px; Text { text: "应用筛选"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; } TouchArea { clicked => { LedgerState.apply-filters(); } } }
            }
        }
        Rectangle { background: MeowTheme.surface-pink; border-radius: 8px; min-height: 48px; Text { text: "＋ 记一笔"; color: MeowTheme.primary-dark; x: 16px; y: 14px; font-weight: 700; } TouchArea { clicked => { LedgerState.new-transaction(); } } }
        for row[index] in LedgerState.transactions: Rectangle { background: MeowTheme.surface; border-radius: 8px; min-height: 112px;
            VerticalBox { padding: 12px; spacing: 4px;
                HorizontalBox { Text { text: row.title; font-weight: 700; color: MeowTheme.ink; horizontal-stretch: 1; } Text { text: row.amount; horizontal-alignment: right; color: MeowTheme.primary-dark; font-weight: 700; } }
                Text { text: row.subtitle; overflow: elide; color: MeowTheme.muted; font-size: 12px; }
                HorizontalBox { Text { text: row.status; color: MeowTheme.muted; horizontal-stretch: 1; } Rectangle { width: 54px; height: 30px; background: MeowTheme.surface-blue; border-radius: 8px; Text { text: "编辑"; color: MeowTheme.primary-dark; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; } TouchArea { clicked => { LedgerState.edit(index,false); } } } }
            }
        }
    }
}

export component EditorPage inherits ScrollView {
    VerticalBox { spacing: 12px;
        Text { text: LedgerState.editor-title; font-size: 28px; font-weight: 700; color: MeowTheme.ink; }
        Rectangle { background: MeowTheme.surface-blue; border-radius: 8px; min-height: 48px; Text { text: LedgerState.editor-hint; wrap: word-wrap; color: MeowTheme.primary-dark; x: 14px; y: 12px; width: parent.width - 28px; } }
        if LedgerState.editing-pending || LedgerState.editing-new: VerticalBox { spacing: 8px;
            ComboBox { model: ["支出", "收入", "转账", "退款"]; current-index <=> LedgerState.editor-kind; }
            Text { text: "记账账户"; color: MeowTheme.muted; }
            ComboBox { model: LedgerState.account-names; current-index <=> LedgerState.editor-account; }
            if LedgerState.editor-kind == 2: ComboBox { model: LedgerState.account-names; current-index <=> LedgerState.editor-destination; }
            LineEdit { placeholder-text: "账户原币金额"; text <=> LedgerState.editor-amount; }
            LineEdit { placeholder-text: "人民币报表金额（外币必填）"; text <=> LedgerState.editor-report; }
            LineEdit { placeholder-text: "日期 YYYY-MM-DD"; text <=> LedgerState.editor-date; }
            LineEdit { placeholder-text: "商户 / 对方"; text <=> LedgerState.editor-merchant; }
            if LedgerState.editor-kind == 3: ComboBox { model: LedgerState.refund-names; current-index <=> LedgerState.editor-refund; }
        }
        ComboBox { model: LedgerState.category-names; current-index <=> LedgerState.editor-category; }
        LineEdit { placeholder-text: "备注"; text <=> LedgerState.editor-memo; }
        Rectangle { background: MeowTheme.primary; border-radius: 8px; min-height: 52px; Text { text: LedgerState.editing-pending ? "确认入账" : "保存修改"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; } TouchArea { clicked => { LedgerState.save-editor(); } } }
        if !LedgerState.editing-new: CheckBox { text: "我确认永久删除当前交易及来源证据"; checked <=> LedgerState.delete-transaction-confirmed; toggled => { LedgerState.confirm-deletion(0, self.checked); } }
        if !LedgerState.editing-new: Button { text: "删除当前交易"; clicked => { LedgerState.delete-data(0); } }
        Button { text: "取消"; clicked => { LedgerState.navigate(LedgerState.editing-pending ? 2 : 1); } }
    }
}
